# Optional for a separately hosted API. Leave unset for the Vercel-native route.
NEXT_PUBLIC_API_URL=

# Required by the Vercel-native 80k Qdrant vector search.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key
HUGGINGFACE_API_TOKEN=replace-with-hugging-face-read-token
